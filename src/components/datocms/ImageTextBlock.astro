---
const { block = {} } = Astro.props;

const title = block.title || '';
const text = block.text || '';
const image = block.image || null;
const imagePosition = block.image_position === 'left' ? 'left' : 'right';
---

<section class="cms-block cms-image-text" data-block-type="image-text" data-image-position={imagePosition}>
  <div class="cms-wrap">
    {image?.url && imagePosition === 'left' && (
      <img src={image.url} alt={image.alt || title || 'Image'} loading="lazy" />
    )}
    <div>
      {title && <h2>{title}</h2>}
      {text && <p>{text}</p>}
    </div>
    {image?.url && imagePosition === 'right' && (
      <img src={image.url} alt={image.alt || title || 'Image'} loading="lazy" />
    )}
  </div>
</section>
