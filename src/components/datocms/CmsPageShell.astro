---
const {
  contentHtml = '',
  footer = '',
  logo = null,
  menu = [],
  socialLink = '',
  title = 'SecuryTI',
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light; }
      body { margin: 0; font-family: Arial, sans-serif; line-height: 1.5; color: #0f172a; }
      .wrap { width: min(1120px, 92vw); margin: 0 auto; }
      header { padding: 16px 0; border-bottom: 1px solid #e2e8f0; }
      nav ul { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; margin: 12px 0 0; }
      nav a { color: inherit; text-decoration: none; }
      main { padding: 28px 0; }
      img { max-width: 100%; height: auto; }
      .cms-block { padding: 20px 0; }
      .cms-wrap { width: min(1120px, 92vw); margin: 0 auto; }
      .cms-image-text .cms-wrap { display: grid; gap: 16px; align-items: center; }
      .cms-image-text[data-image-position="left"] .cms-wrap { grid-template-columns: minmax(220px, 1fr) 2fr; }
      .cms-image-text[data-image-position="right"] .cms-wrap { grid-template-columns: 2fr minmax(220px, 1fr); }
      footer { padding: 24px 0; border-top: 1px solid #e2e8f0; color: #475569; }
      @media (max-width: 900px) {
        .cms-image-text .cms-wrap,
        .cms-image-text[data-image-position="left"] .cms-wrap,
        .cms-image-text[data-image-position="right"] .cms-wrap { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        {logo?.url ? <img src={logo.url} alt={logo.alt || 'Logo'} loading="eager" /> : <strong>SecuryTI</strong>}
        {menu.length > 0 && (
          <nav aria-label="Main menu">
            <ul>
              {menu.map((item) => (
                <li><a href={item.url || '#'}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </header>

    <main>
      <slot />
      {contentHtml && <section class="cms-block"><div class="cms-wrap" set:html={contentHtml} /></section>}
    </main>

    <footer>
      <div class="wrap">
        {footer ? <p>{footer}</p> : <p>SecuryTI</p>}
        {socialLink && (
          <p>
            <a href={socialLink}>Social</a>
          </p>
        )}
      </div>
    </footer>
  </body>
</html>
